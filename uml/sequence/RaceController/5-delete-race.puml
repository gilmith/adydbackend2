@startuml delete-race
title DELETE /race/{raceId} — deleteRace
' Capas: Web(controller) -> Aplicación(serviceImpl) -> Puerto(repository) -> Infraestructura(Jpa/Mapper/Entity)

actor Cliente
participant "RaceController" as RC
participant "RaceServiceImpl\n(implements RaceService)" as RS
participant "RaceRepositoryAdapter\n(implements RaceRepository)" as RA
participant "RaceJpaRepository" as RJ

Cliente -> RC : DELETE /race/{raceId}
RC -> RS : deleteRace(raceId)
RS -> RA : deleteById(raceId)
RA -> RJ : deleteById(raceId)
RJ --> RA : ok
RA --> RS : ok
RS --> RC : ok
RC --> Cliente : 202 Accepted (sin body)

@enduml